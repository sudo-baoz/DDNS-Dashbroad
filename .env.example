# PulseDNS Environment Configuration
# Designed for private Homelab / trusted network deployment (No user login required)

# Database: SQLite path (file:./prisma/pulsedns.db for local dev, or file:/app/data/pulsedns.db for Docker)
DATABASE_URL="file:./prisma/pulsedns.db"

# Encryption Key: 64-character hex string (32 bytes) used for AES-256-GCM encryption of Cloudflare tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-char-hex-key-generate-via-openssl-rand-hex-32"

# Server Port & Binding
PORT=3000

# Background DDNS Worker Engine
ENABLE_WORKER="true"

# Node Environment
NODE_ENV="production"

# Optional: Comma-separated list of trusted origins/hosts for reverse proxies
# Example: TRUSTED_ORIGINS="http://192.168.1.50:3000,http://pulsedns.lan,https://ddns.myhomelab.net"
# TRUSTED_ORIGINS=""
