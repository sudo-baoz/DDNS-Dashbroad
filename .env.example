# PulseDNS Production / Example Environment Configuration

# Database: SQLite path (file:./data/pulsedns.db for Docker or file:./pulsedns.db for local)
DATABASE_URL="file:./pulsedns.db"

# Session Secret: Random 32+ character string used for session cookie signing
SESSION_SECRET="replace-with-a-random-secure-string-at-least-32-chars-long"

# Encryption Key: 64-character hex string (32 bytes) used for AES-256-GCM encryption of provider tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-char-hex-key-generate-via-openssl-rand-hex-32"

# Server Port
PORT=3000

# Background Worker
ENABLE_WORKER="true"

# Node Environment
NODE_ENV="production"
